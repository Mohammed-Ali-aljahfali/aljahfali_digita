6nbsp;على\u0026nbsp;المنصة.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"color: rgb(122, 121, 138);\"\u003eمواضيع\u0026nbsp;متنوعة\u0026nbsp;تشمل\u0026nbsp;تطوير\u0026nbsp;الويب،\u0026nbsp;وعلوم\u0026nbsp;البيانات،\u0026nbsp;والذكاء\u0026nbsp;الاصطناعي،\u0026nbsp;وغيرها.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"color: rgb(122, 121, 138);\"\u003eتحديث\u0026nbsp;مستمر\u0026nbsp;للمحتوى\u0026nbsp;لمواكبة\u0026nbsp;أحدث\u0026nbsp;التطورات\u0026nbsp;في\u0026nbsp;عالم\u0026nbsp;البرمجة.\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003e\u003cstrong style=\"color: rgb(122, 121, 138);\"\u003eنهج\u0026nbsp;عملي\u0026nbsp;وممتع:\u003c/strong\u003e\u003cul\u003e\u003cli\u003e\u003cspan style=\"color: rgb(122, 121, 138);\"\u003eيركز\u0026nbsp;على\u0026nbsp;الممارسة\u0026nbsp;العملية\u0026nbsp;بدلاً\u0026nbsp;من\u0026nbsp;النظريات\u0026nbsp;الجافة،\u0026nbsp;مما\u0026nbsp;يعزز\u0026nbsp;مهاراتك\u0026nbsp;بشكل\u0026nbsp;فعال.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"color: rgb(122, 121, 138);\"\u003eواجهة\u0026nbsp;مستخدم\u0026nbsp;جذابة\u0026nbsp;وسهلة\u0026nbsp;الاستخدام\u0026nbsp;تساعدك\u0026nbsp;على\u0026nbsp;التركيز\u0026nbsp;على\u0026nbsp;التعلم.\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003e\u003cstrong style=\"color: rgb(122, 121, 138);\"\u003eمجتمع\u0026nbsp;داعم:\u003c/strong\u003e\u003cul\u003e\u003cli\u003e\u003cspan style=\"color: rgb(122, 121, 138);\"\u003eاحصل\u0026nbsp;على\u0026nbsp;إرشادات\u0026nbsp;خطوة\u0026nbsp;بخطوة\u0026nbsp;من\u0026nbsp;الخبراء،\u0026nbsp;ودعم\u0026nbsp;من\u0026nbsp;مجتمع\u0026nbsp;من\u0026nbsp;ملايين\u0026nbsp;المتعلمين\u0026nbsp;حول\u0026nbsp;العالم.\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003e\u003cstrong style=\"color: rgb(122, 121, 138);\"\u003eلمن\u0026nbsp;يناسب\u0026nbsp;هذا\u0026nbsp;الاشتراك؟\u003c/strong\u003e\u003cul\u003e\u003cli\u003e\u003cstrong style=\"color: rgb(122, 121, 138);\"\u003eالطلاب:\u003c/strong\u003e\u003cspan style=\"color: rgb(122, 121, 138);\"\u003e\u0026nbsp;الذين\u0026nbsp;يرغبون\u0026nbsp;في\u0026nbsp;تعلم\u0026nbsp;أساسيات\u0026nbsp;البرمجة\u0026nbsp;أو\u0026nbsp;تعزيز\u0026nbsp;مهاراتهم.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cstrong style=\"color: rgb(122, 121, 138);\"\u003eالمحترفون:\u003c/strong\u003e\u003cspan style=\"color: rgb(122, 121, 138);\"\u003e\u0026nbsp;مثل\u0026nbsp;مسوقي\u0026nbsp;الإنترنت،\u0026nbsp;ومصممي\u0026nbsp;الجرافيك،\u0026nbsp;والذين\u0026nbsp;يحتاجون\u0026nbsp;إلى\u0026nbsp;تعزيز\u0026nbsp;معرفتهم\u0026nbsp;التقنية.\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp class=\"ql-direction-rtl\"\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl\"\u003e\u003cstrong style=\"color: rgb(122, 121, 138);\"\u003e\u0026nbsp;شروط\u0026nbsp;الضمان:\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cspan style=\"color: rgb(122, 121, 138);\"\u003eلا\u0026nbsp;تقم\u0026nbsp;بتغيير\u0026nbsp;البريد\u0026nbsp;الإلكتروني\u0026nbsp;أو\u0026nbsp;كلمة\u0026nbsp;المرور\u0026nbsp;الخاصة\u0026nbsp;بالحساب.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"color: rgb(122, 121, 138);\"\u003eلا\u0026nbsp;تشارك\u0026nbsp;الحساب\u0026nbsp;مع\u0026nbsp;أي\u0026nbsp;شخص\u0026nbsp;آخر،\u0026nbsp;لضمان\u0026nbsp;استمرارية\u0026nbsp;الخدمة.\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp class=\"ql-direction-rtl\"\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl\"\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"7b:T104b,"])</script><script>self.__next_f.push([1,"\u003cp class=\"ql-direction-rtl\"\u003e\u003cstrong style=\"color: rgb(122, 121, 138);\"\u003eاشتراك\u0026nbsp;Codecademy\u0026nbsp;Pro:\u0026nbsp;رحلتك\u0026nbsp;نحو\u0026nbsp;احتراف\u0026nbsp;البرمجة\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl\"\u003e\u003cspan style=\"color: rgb(122, 121, 138);\"\u003eيُعد\u0026nbsp;\u003c/span\u003e\u003cstrong sty