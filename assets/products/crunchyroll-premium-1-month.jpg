 لزيادة مبيعات SQLyem وجذب عملاء جدد.\",\"1067\":\"إضافة كوبون جديد\",\"1068\":\"لا توجد كوبونات حالياً\",\"1069\":\"كود الخصم الفعال\",\"1070\":\"الخصم\",\"1071\":\"تنتهي في\",\"1072\":\"غير محدد\",\"1073\":\"نشط الآن\",\"1074\":\"غير مفعل\",\"1075\":\"إضافة كوبون جديد\",\"1076\":\"توليد أكواد الخصم\",\"1077\":\"كود الخصم (مثال: SAVE20)\",\"1078\":\"نوع الخصم\",\"1079\":\"نسبة %\",\"1080\":\"قيمة $\",\"1081\":\"قيمة الخصم\",\"1082\":\"تاريخ الانتهاء\",\"1083\":\"إنشاء الكوبون الآن\",\"1084\":\"إدارة الشركاء\",\"1085\":\"إدارة أرصدة الشركاء والوكلاء\",\"1086\":\"إجمالي الأرصدة\",\"1087\":\"تحديث\",\"1088\":\"بحث عن شريك...\",\"1089\":\"لا يوجد شركاء حالياً\",\"1090\":\"شريك\",\"1091\":\"الطلبات\",\"1092\":\"الرصيد\",\"1093\":\"تاريخ التسجيل\",\"1094\":\"المبلغ\",\"1095\":\"ملاحظة\",\"1096\":\"تأكيد\",\"1097\":\"إلغاء\",\"1098\":\"إضافة رصيد\",\"1099\":\"هل تريد خصم 10$ من هذا الشريك؟\",\"1100\":\"خصم يدوي\",\"1101\":\"خصم 10$\",\"1102\":\"هل أنت متأكد من حذف هذا المقال؟\",\"1103\":\"تم الحذف بنجاح\",\"1104\":\"الكل\",\"1105\":\"إرسال حساب جديد\",\"1106\":\"الصورة الرئيسية\",\"1107\":\"معرض الصور الإضافية\",\"1108\":\"إرسال حساب جديد\",\"1109\":\"الصورة الرئيسية\",\"1110\":\"معرض الصور الإضافية\",\"1111\":\"لا توجد أقسام حالياً.\",\"1112\":\"لا يوجد أقسام فرعية\",\"1113\":\"عرض في المتجر\",\"1114\":\"تعديل\",\"1115\":\"حذف\",\"1116\":\"أنت على وشك حذف\",\"1117\":\"سيتم حذف جميع التصنيفات الفرعية المرتبطة أيضاً.\",\"1118\":\"هذا الرابط (Slug) موجود بالفعل، يرجى اختيار اسم آخر\",\"1119\":\"نظام إدارة المفاتيح الرقمية\",\"1120\":\"المفاتيح\",\"1121\":\"الرقمية\",\"1122\":\"قم بإضافة مفاتيح المنتجات (أكواد التفعيل) وإدارة المخزون الرقمي لـ SQLyem.\",\"1123\":\"إضافة مفاتيح بالجملة\",\"1124\":\"بحث في المفاتيح أو المنتجات...\",\"1125\":\"متاح\",\"1126\":\"مباع\",\"1127\":\"المفتاح الرقمي\",\"1128\":\"المنتج المرتبط\",\"1129\":\"تاريخ الإضافة\",\"1130\":\"لا توجد مفاتيح رقمية حالياً\",\"1131\":\"إضافة مفاتيح بالجملة\",\"1132\":\"تعبئة المخزون الرقمي\",\"1133\":\"اختر المنتج المرتبط\",\"1134\":\"اختر منتجاً...\",\"1135\":\"اختر الفئة (Denomination)\",\"1136\":\"اختر الفئة...\",\"1137\":\"المفاتيح الرقمية (مفتاح في كل سطر)\",\"1138\":\"سيتم إضافة كل سطر كمفتاح رقمي مستقل متاح للبيع في متجر SQLyem.\",\"1139\":\"تأكيد الاستيراد والمزامنة\",\"1140\":\"border-l-4 pl-4 border-primary/20\",\"1141\":\"مهمة\",\"1142\":\"لا توجد مهام مجدولة بعد\",\"1143\":\"التشغيل التلقائي الخارجي\",\"1144\":\"لتشغيل المهام تلقائياً، أضف الرابط التالي في خدمة cron-job.org (مجانية):\",\"1145\":\"تعبير Cron\",\"1146\":\"وقت البدء\",\"1147\":\"تم حفظ الإعدادات بنجاح ✓\",\"1148\":\"فشل حفظ الإعدادات\",\"1149\":\"خطأ غير متوقع\",\"1150\":\"إعدادات لوحة التحكم\",\"1151\":\"تحكم كامل بجميع جوانب المتجر ولوحة التحكم\",\"1152\":\"جاري الحفظ...\",\"1153\":\"حفظ التغييرات\",\"1154\":\"اسم المتجر\",\"1155\":\"شعار المتجر\",\"1156\":\"بدون شعار\",\"1157\":\"حذف الشعار\",\"1158\":\"ارفع شعار المتجر. يُوصى بحجم 200×200 بكسل بخلفية شفافة (PNG).\",\"1159\":\"رفع صورة\",\"1160\":\"أو أدخل رابط الصورة\",\"1161\":\"وصف المتجر\",\"1162\":\"القسم الرئيسي (Hero)\",\"1163\":\"نص الفوتر\",\"1164\":\"وضع العرض\",\"1165\":\"اللون الرئيسي\",\"1166\":\"لون مخصص:\",\"1167\":\"ألوان الشعار\",\"1168\":\"لون الشعار في الوضع الفاتح\",\"1169\":\"لون الشعار في الوضع الداكن\",\"1170\":\"نظام التصميم\",\"1171\":\"طريقة عرض الصفحة الرئيسية\",\"1172\":\"اختر كيف تريد عرض المحتوى في الصفحة الرئيسية للمتجر\",\"1173\":\"منتجات حسب القسم\",\"1174\":\"عرض المنتجات مع سلايدر لكل قسم\",\"1175\":\"مفعل\",\"1176\":\"أقسام فقط\",\"1177\":\"عرض الأقسام بصورها وأسمائها فقط\",\"1178\":\"مفعل\",\"1179\":\"الخط العربي\",\"1180\":\"الخط الإنجليزي\",\"1181\":\"معاينة مباشرة\",\"1182\":\"العملة الافتراضية\",\"1183\":\"مفعل\",\"1184\":\"إعدادات الأرشفة وSEO\",\"1185\":\"العنوان البرمجي (EN)\",\"1186\":\"الوصف البرمجي (EN)\",\"1187\":\"العنوان البرمجي (AR)\",\"1188\":\"الوصف البرمجي (AR)\",\"1189\":\"أيقونة الموقع (Favicon)\",\"1190\":\"بدون أيقونة\",\"1191\":\"حذف الأيقونة\",\"1192\":\"ارفع أيقونة الموقع (Favicon). يُفضل أن تكون بحجم 64×64 بكسل بصيغة PNG أو ICO.\",\"1193\":\"رفع صورة\",\"1194\":\"أو أدخل رابط الأيقونة\",\"1195\":\"معلومات التواصل والدعم\",\"1196\":\"روابط التواصل الاجتماعي\",\"1197\":\"سياسة الخصوصية\",\"1198\":\"شروط الخدمة\",\"1199\":\"إعدادات الربط وتسجيل الدخول\",\"1200\":\"قم بإعداد مفاتيح الربط الخاصة بجوجل وفيسبوك لتمكين العملاء من تسجيل الدخول بضغطة زر واحدة.\",\"1201\":\"ابدأ الإعداد الآن\",\"1202\":\"يجب تفعيل Google OAuth في منصة جوجل واستخدام رابط التوجيه التالي:\",\"1203\":\"يجب تفعيل Facebook Login في منصة المطورين واستخدام رابط التوجيه التالي:\",\"1204\":\"إعدادات برمجية متقدمة\",\"1205\":\"أكواد برمجية مخصصة للرأس (Head Scripts)\",\"1206\":\"سيتم حقن هذه الأكواد داخل وسم \u003chead\u003e في جميع صفحات المتجر. استخدمها لـ Meta Pixel أو Snapchat Pixel.\",\"1207\":\"إعدادات الربط والتحقق (OAuth)\",\"1208\":\"إدارة مفاتيح ربط جوجل وفيسبوك لتسجيل الدخول.\",\"1209\":\"اذهب للإعدادات\",\"1210\":\"فشل جلب الإعدادات\",\"1211\":\"تم حفظ التعديلات! يجب إعادة التشغيل لتطبيقها.\",\"1212\":\"فشل الحفظ\",\"1213\":\"هل أنت متأكد من رغبتك في إعادة تشغيل النظام؟ سيؤدي ذلك لقطع الاتصال لثوانٍ معدودة.\",\"1214\":\"جاري إعادة التشغيل... يرجى الانتظار\",\"1215\":\"فشل إعادة التشغيل\",\"1216\":\"العودة للإعدادات\",\"1217\":\"إعدادات تسجيل الدخول\",\"1218\":\"إدارة مفاتيح الربط لتسجيل الدخول عبر الشبكات الاجتماعية (جوجل، فيسبوك).\",\"1219\":\"إعادة تشغيل النظام لتطبيق التغييرات\",\"1220\":\"ملاحظة هامة جداً\",\"1221\":\"المفاتيح هنا يتم حفظها في ملف السيرفر المشفر بشكل مباشر لضمان أعلى درجات الأمان الموصى بها. لكي يتم تفعيل الإعدادات الجديدة، يجب عليك الضغط على زر إعادة التشغيل (Restart) بعد الحفظ.\",\"1222\":\"مفعل وجاهز\",\"1223\":\"غير مفعل\",\"1224\":\"مفعل وجاهز\",\"1225\":\"غير مفعل\",\"1226\":\"حفظ مفاتيح الربط\",\"1227\":\"مسؤول أعلى\",\"1228\":\"مسؤول\",\"1229\":\"موظف\",\"1230\":\"دعم فني\",\"1231\":\"شريك/وكيل\",\"1232\":\"عميل\",\"1233\":\"الكل\",\"1234\":\"مسؤولين\",\"1235\":\"شركاء\",\"1236\":\"موظفين\",\"1237\":\"عملاء\",\"1238\":\"إدارة صلاحيات الموظفين والعملاء والشركاء\",\"1239\":\"بحث...\",\"1240\":\"لا يوجد مستخدمين\",\"1241\":\"مستخدم\",\"1242\":\"عرض وإدارة جميع تنبيهات المتجر والعمليات\",\"1243\":\"تأشير الكل كمقروء\",\"1244\":\"لا توجد أي إشعارات!\",\"1245\":\"أنت على إطلاع بكل جديد، صندوق الإشعارات فارغ.\",\"1246\":\"عرض التفاصيل\",\"1247\":\"تأشير كمقروء\",\"1248\":\"الاسم الكامل\",\"1249\":\"pr-12 sm:pr-14 pl-4 sm:pl-6 text-right\",\"1250\":\"pr-12 sm:pr-14 pl-4 sm:pl-6 text-right\",\"1251\":\"pr-12 sm:pr-14 pl-4 sm:pl-6 text-right\",\"1252\":\"استعادة كلمة المرور\",\"1253\":\"أدخل بريدك الإلكتروني وسنرسل لك رابطاً لإعادة تعيين كلمة المرور.\",\"1254\":\"البريد الإلكتروني\",\"1255\":\"جاري الإرسال...\",\"1256\":\"إرسال رابط إعادة التعيين\",\"1257\":\"pr-12 sm:pr-14 pl-4 sm:pl-6 text-right\",\"1258\":\"pr-12 sm:pr-14 pl-4 sm:pl-6 text-right\",\"1259\":\"نسيت كلمة المرور؟\",\"1260\":\"رصيد غير كافٍ\",\"1261\":\"اذهب إلى لوحة الشريك\",\"1262\":\"الشراء بالرصيد\",\"1263\":\"رصيدك\",\"1264\":\"ادفع من رصيدك المتاح\",\"1265\":\"أنت لست شريكاً، استخدم طرق الدفع العادية\",\"1266\":\"خدمة يمنية\",\"1267\":\"تحويل بنكي\",\"1268\":\"أكمل الدفع عبر الخدمة اليمنية\",\"1269\":\"أكمل عملية الدفع البنكي\",\"1270\":\"بيانات الحساب اليمني\",\"1271\":\"الحسابات البنكية المتاحة\",\"1272\":\"شريك\",\"1273\":\"إيداع\",\"1274\":\"شراء\",\"1275\":\"تعديل\",\"1276\":\"لوحة التحكم\",\"1277\":\"مرحباً بك في لوحة تحكم الشريك\",\"1278\":\"تواصل مع المدير\",\"1279\":\"الرصيد الحالي\",\"1280\":\"إجمالي الطلبات\",\"1281\":\"مكتملة\",\"1282\":\"قيد المعالجة\",\"1283\":\"جدول المشتريات\",\"1284\":\"لا توجد مشتريات حتى الآن\",\"1285\":\"معرف العملية\",\"1286\":\"اسم المنتج\",\"1287\":\"العدد\",\"1288\":\"السعر\",\"1289\":\"إجمالي السعر\",\"1290\":\"تاريخ الطلب\",\"1291\":\"طريقة التفعيل\",\"1292\":\"الحالة\",\"1293\":\"الرصيد الحالي\",\"1294\":\"تلقائي\",\"1295\":\"إيميل\",\"1296\":\"إيميل وباسورد\",\"1297\":\"حساب مخصص\",\"1298\":\"مكتمل\",\"1299\":\"قيد المعالجة\",\"1300\":\"جدول سجل الرصيد\",\"1301\":\"لا توجد حركات مالية حتى الآن\",\"1302\":\"معرف العملية\",\"1303\":\"الرصيد الحالي\",\"1304\":\"نوع العملية\",\"1305\":\"المبلغ\",\"1306\":\"التاريخ\",\"1307\":\"الرصيد الإجمالي الحالي\",\"1308\":\"مرحباً بك في المتجر\",\"1309\":\"أضف سلايدرات من لوحة التحكم\",\"1310\":\"الأحدث\",\"1311\":\"السعر: من الأقل\",\"1312\":\"السعر: من الأعلى\",\"1313\":\"الأكثر مبيعاً\",\"1314\":\"ترتيب\",\"1315\":\"لا يوجد محتوى متوفر حالياً.\",\"1316\":\"مشاركة المنتج\",\"1317\":\"إضافة للمفضلة\",\"1318\":\"عرض الكل\",\"1319\":\"تصفح حسب\",\"1320\":\"الأقسام\",\"1321\":\"منتجات\",\"1322\":\"الأخبار والعروض\",\"1323\":\"عرض الكل\",\"1324\":\"ابدأ التسوق الآن\",\"1325\":\"اكتشف أفضل العروض على الاشتراكات والبطاقات الرقمية\",\"1326\":\"عرض الكل\",\"1327\":\"تفاصيل المنتج\",\"1328\":\"المميزات\",\"1329\":\"طريقة التفعيل\",\"1330\":\"الأسئلة الشائعة\",\"1331\":\"بطاقة رقمية أصلية وآمنة لتعبئة رصيدك أو الاشتراك في خدماتك المفضلة بسرعة وسهولة. لمعرفة الشروط والوصف الكامل، يرجى النقر على أيقونة التفاصيل (i) بجوار التبويبات.\",\"1332\":\"كيف يمكنني استلام كود البطاقة؟\",\"1333\":\"بمجرد إتمام عملية الدفع، سيتم إرسال الكود فوراً إلى بريدك الإلكتروني وسيظهر أيضاً في لوحة تحكم حسابك.\",\"1334\":\"هل يمكنني استرداد المبلغ بعد الشراء؟\",\"1335\":\"نظراً لطبيعة المنتجات الرقمية، لا يمكننا تقديم استرداد مالي بعد كشف الكود. يرجى التأكد من اختيار المنتج الصحيح قبل الدفع.\",\"1336\":\"عرض الوصف الكامل\",\"1337\":\"تفاصيل المنتج الكاملة\",\"1338\":\"إغلاق\",\"1339\":\"نحن في SQLyem نسعى دائماً لتوفير تجربة رقمية لا مثيل لها. سواء كنت تبحث عن الترفيه، أو أدوات الإنتاجية، أو الأمان الرقمي، فإن متجرنا هو الخيار الأمثل لك بفضل أسعارنا المنافسة ودعمنا الفني المتواجد على مدار الساعة.\",\"1340\":\"border-r-4 border-primary pr-3 text-right\",\"1341\":\"مشتري موثق\",\"1342\":\"اكتشف معنا أهم التحديثات البرمجية والاشتراكات الرقمية لهذا الموسم بأسلوب SQLYEM المميز...\",\"1343\":\"حساب\",\"1344\":\"حساب\",\"1345\":\"هل أنت متأكد من حذف هذا الطلب نهائياً؟\",\"1346\":\"تم حذف الطلب\",\"1347\":\"فشل الحذف\",\"1348\":\"حذف الطلب\",\"1349\":\"العودة للطلبات\",\"1350\":\"طريقة الدفع\",\"1351\":\"إجمالي المبلغ\",\"1352\":\"إيصال الدفع\",\"1353\":\"قائمة المنتجات\",\"1354\":\"أصناف في هذا الطلب\",\"1355\":\"سعر الوحدة\",\"1356\":\"بيانات التفعيل (العميل)\",\"1357\":\"بيانات التسليم\",\"1358\":\"تجهيز حساب جديد\",\"1359\":\"مطلوب للتسليم\",\"1360\":\"إحصائيات النظام\",\"1361\":\"تحليل كامل للمبيعات والنمو\",\"1362\":\"المبيعات (آخر 7 أيام)\",\"1363\":\"توزيع المنتجات\",\"1364\":\"مكتبة الوسائط\",\"1365\":\"اختر صورة للنظام\",\"1366\":\"ابحث...\",\"1367\":\"تحديث\",\"1368\":\"جاري التحميل...\",\"1369\":\"المكتبة فارغة\",\"1370\":\"اختيار الملف\",\"1371\":\"اختر من المكتبة\"},\"reviews\":{\"count\":\"{count} تقييم\",\"empty\":\"لا يوجد تقييمات لهذا المنتج بعد. كن أول من يقيم!\",\"anonymous\":\"مستخدم مجهول\"},\"products\":{\"allTitle\":\"جميع الاشتراكات | {siteName}\",\"allDescription\":\"تصفح مجموعتنا الواسعة من الاشتراكات الرقمية بأفضل الأسعار.\",\"empty\":\"لا توجد منتجات متاحة حالياً.\",\"notFoundTitle\":\"المنتج غير موجود\",\"notFoundHeading\":\"عذراً، المنتج غير موجود\",\"notFoundDesc\":\"ربما تم حذف المنتج أو أن الرابط غير صحيح.\",\"backToStore\":\"العودة للمتجر\"},\"partner\":{\"backToStore\":\"العودة للمتجر\"},\"categories\":{\"badge\":\"تصنيفاتنا\",\"indexTitle\":\"جميع التصنيفات\",\"indexDescription\":\"استعرض كل تصنيفاتنا الرقمية واختر ما يناسبك\",\"browse\":\"تصفح\",\"empty\":\"لا توجد تصنيفات حالياً\"}},\"now\":\"$undefined\",\"timeZone\":\"UTC\",\"children\":\"$L15\"}]\n"])</script><script>self.__next_f.push([1,"16:I[86318,[\"/_next/static/chunks/1608cak20tcw1.js\",\"/_next/static/chunks/133rq7uo7d2_0.js\",\"/_next/static/chunks/0311y4cy1f7h0.js\",\"/_next/static/chunks/09t2isllljna7.js\",\"/_next/static/chunks/0h1vh1yojz0fq.js\"],\"DirectionProvider\"]\n17:I[59003,[\"/_next/static/chunks/1608cak20tcw1.js\",\"/_next/static/chunks/133rq7uo7d2_0.js\",\"/_next/static/chunks/0311y4cy1f7h0.js\",\"/_next/static/chunks/09t2isllljna7.js\",\"/_next/static/chunks/0h1vh1yojz0fq.js\"],\"AppSettingsProvider\"]\n18:T1ae2,"])</script><script>self.__next_f.push([1,"\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eسياسة\u0026nbsp;الخصوصية\u0026nbsp;لمنصة\u0026nbsp;SQLyem\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eتاريخ\u0026nbsp;آخر\u0026nbsp;تحديث\u003c/strong\u003e\u0026nbsp;[13\u0026nbsp;سبتمبر\u0026nbsp;2026]\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003eمرحباً\u0026nbsp;بك\u0026nbsp;في\u0026nbsp;منصة\u0026nbsp;\u003cstrong\u003eSQLyem\u003c/strong\u003e.\u0026nbsp;نحن\u0026nbsp;نقدر\u0026nbsp;خصوصيتك\u0026nbsp;ونلتزم\u0026nbsp;بحماية\u0026nbsp;بياناتك\u0026nbsp;الشخصية.\u0026nbsp;توضح\u0026nbsp;سياسة\u0026nbsp;الخصوصية\u0026nbsp;هذه\u0026nbsp;كيف\u0026nbsp;نقوم\u0026nbsp;بجمع،\u0026nbsp;استخدام،\u0026nbsp;حماية،\u0026nbsp;ومشاركة\u0026nbsp;معلوماتك\u0026nbsp;عند\u0026nbsp;استخدامك\u0026nbsp;لموقعنا\u0026nbsp;الإلكتروني\u0026nbsp;وخدماتنا.\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eأولاً:\u0026nbsp;المعلومات\u0026nbsp;التي\u0026nbsp;نجمعها\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003eنحن\u0026nbsp;نجمع\u0026nbsp;أنواعاً\u0026nbsp;معينة\u0026nbsp;من\u0026nbsp;المعلومات\u0026nbsp;لتقديم\u0026nbsp;وتحسين\u0026nbsp;خدماتنا:\u003c/p\u003e\u003col\u003e\u003cli\u003e\u003cstrong\u003eالمعلومات\u0026nbsp;الشخصية\u0026nbsp;\u003c/strong\u003eعند\u0026nbsp;التسجيل\u0026nbsp;أو\u0026nbsp;الشراء،\u0026nbsp;نجمع\u0026nbsp;اسمك،\u0026nbsp;بريدك\u0026nbsp;الإلكتروني،\u0026nbsp;ورقم\u0026nbsp;هاتفك\u0026nbsp;(إن\u0026nbsp;وجد).\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eمعلومات\u0026nbsp;الدف،\u003c/strong\u003e\u0026nbsp;نحن\u0026nbsp;لا\u0026nbsp;نخزن\u0026nbsp;تفاصيل\u0026nbsp;بطاقتك\u0026nbsp;الائتمانية\u0026nbsp;على\u0026nbsp;خوادمنا.\u0026nbsp;تتم\u0026nbsp;معالجة\u0026nbsp;جميع\u0026nbsp;المدفوعات\u0026nbsp;بشكل\u0026nbsp;آمن\u0026nbsp;عبر\u0026nbsp;بوابات\u0026nbsp;دفع\u0026nbsp;طرف\u0026nbsp;ثالث\u0026nbsp;معتمدة\u0026nbsp;(مثل\u0026nbsp;Stripe,\u0026nbsp;2Checkout,\u0026nbsp;Hoodpay).\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eبيانات\u0026nbsp;الاستخدام،\u003c/strong\u003e\u0026nbsp;نجمع\u0026nbsp;معلومات\u0026nbsp;تلقائية\u0026nbsp;حول\u0026nbsp;كيفية\u0026nbsp;تفاعلك\u0026nbsp;مع\u0026nbsp;المنصة،\u0026nbsp;مثل\u0026nbsp;عنوان\u0026nbsp;بروتوكول\u0026nbsp;الإنترنت\u0026nbsp;(IP)،\u0026nbsp;نوع\u0026nbsp;المتصفح،\u0026nbsp;الصفحات\u0026nbsp;التي\u0026nbsp;زرتها،\u0026nbsp;وتفضيلات\u0026nbsp;اللغة.\u003c/li\u003e\u003c/ol\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eثانياً:\u0026nbsp;كيف\u0026nbsp;نستخدم\u0026nbsp;معلوماتك\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003eنستخدم\u0026nbsp;البيانات\u0026nbsp;التي\u0026nbsp;نجمعها\u0026nbsp;للأغراض\u0026nbsp;التالية:\u003c/p\u003e\u003col\u003e\u003cli\u003eمعالجة\u0026nbsp;طلباتك\u0026nbsp;وتوصيل\u0026nbsp;المنتجات\u0026nbsp;الرقمية\u0026nbsp;أو\u0026nbsp;المادية.\u003c/li\u003e\u003cli\u003eإدارة\u0026nbsp;حسابك\u0026nbsp;(سواء\u0026nbsp;كنت\u0026nbsp;عميلاً،\u0026nbsp;شريكاً،\u0026nbsp;أو\u0026nbsp;مسؤولاً).\u003c/li\u003e\u003cli\u003eتحسين\u0026nbsp;واجهة\u0026nbsp;المستخدم\u0026nbsp;وتجربة\u0026nbsp;التسوق\u0026nbsp;بناءً\u0026nbsp;على\u0026nbsp;تفضيلاتك\u0026nbsp;(مثل\u0026nbsp;حفظ\u0026nbsp;تفضيلات\u0026nbsp;الوضع\u0026nbsp;الليلي\u0026nbsp;واللغة).\u003c/li\u003e\u003cli\u003eإرسال\u0026nbsp;التحديثات\u0026nbsp;المهمة،\u0026nbsp;فواتير\u0026nbsp;الشراء،\u0026nbsp;ورسائل\u0026nbsp;الدعم\u0026nbsp;الفني.\u003c/li\u003e\u003cli\u003eمنع\u0026nbsp;الاحتيال\u0026nbsp;وضمان\u0026nbsp;أمان\u0026nbsp;المنصة.\u003c/li\u003e\u003c/ol\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eثالثاً:\u0026nbsp;مشاركة\u0026nbsp;البيانات\u0026nbsp;والإفصاح\u0026nbsp;عنها\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003eنحن\u0026nbsp;لا\u0026nbsp;نبيع\u0026nbsp;بياناتك\u0026nbsp;الشخصية\u0026nbsp;لأي\u0026nbsp;طرف\u0026nbsp;ثالث.\u0026nbsp;قد\u0026nbsp;نشارك\u0026nbsp;بياناتك\u0026nbsp;فقط\u0026nbsp;في\u0026nbsp;الحالات\u0026nbsp;التالية:\u003c/p\u003e\u003col\u003e\u003cli\u003e\u003cstrong\u003eمزودي\u0026nbsp;الخدمات،\u003c/strong\u003e\u0026nbsp;نشارك\u0026nbsp;بيانات\u0026nbsp;ضرورية\u0026nbsp;مع\u0026nbsp;بوابات\u0026nbsp;الدفع\u0026nbsp;أو\u0026nbsp;شركات\u0026nbsp;الشحن\u0026nbsp;لإتمام\u0026nbsp;طلبك.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالامتثال\u0026nbsp;القانوني،\u003c/strong\u003e\u0026nbsp;قد\u0026nbsp;نفصح\u0026nbsp;عن\u0026nbsp;معلوماتك\u0026nbsp;إذا\u0026nbsp;كان\u0026nbsp;ذلك\u0026nbsp;مطلوباً\u0026nbsp;بموجب\u0026nbsp;القانون\u0026nbsp;أو\u0026nbsp;استجابة\u0026nbsp;لطلب\u0026nbsp;قانوني\u0026nbsp;من\u0026nbsp;السلطات\u0026nbsp;المختصة.\u003c/li\u003e\u003c/ol\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eرابعاً:\u0026nbsp;أمن\u0026nbsp;البيانات\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003eنحن\u0026nbsp;نتخذ\u0026nbsp;تدابير\u0026nbsp;أمنية\u0026nbsp;تقنية\u0026nbsp;وتنظيمية\u0026nbsp;صارمة\u0026nbsp;لحماية\u0026nbsp;بياناتك\u0026nbsp;من\u0026nbsp;الوصول\u0026nbsp;غير\u0026nbsp;المصرح\u0026nbsp;به\u0026nbsp;أو\u0026nbsp;التعديل\u0026nbsp;أو\u0026nbsp;الحذف.\u0026nbsp;جميع\u0026nbsp;البيانات\u0026nbsp;المنقولة\u0026nbsp;بين\u0026nbsp;متصفحك\u0026nbsp;وخوادمنا\u0026nbsp;مشفرة\u0026nbsp;باستخدام\u0026nbsp;بروتوكولات\u0026nbsp;الأمان\u0026nbsp;القياسية\u0026nbsp;(SSL/TLS).\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eخامساً:\u0026nbsp;حقوقك\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003eبصفتك\u0026nbsp;مستخدماً\u0026nbsp;لمنصة\u0026nbsp;SQLyem،\u0026nbsp;يحق\u0026nbsp;لك:\u003c/p\u003e\u003col\u003e\u003cli\u003eالوصول\u0026nbsp;إلى\u0026nbsp;بياناتك\u0026nbsp;الشخصية\u0026nbsp;وتعديلها\u0026nbsp;عبر\u0026nbsp;صفحة\u0026nbsp;\u0026quot;حسابي\u0026quot;.\u003c/li\u003e\u003cli\u003eطلب\u0026nbsp;حذف\u0026nbsp;حسابك\u0026nbsp;وبياناتك\u0026nbsp;من\u0026nbsp;أنظمتنا.\u003c/li\u003e\u003cli\u003eسحب\u0026nbsp;موافقتك\u0026nbsp;على\u0026nbsp;استلام\u0026nbsp;الرسائل\u0026nbsp;التسويقية\u0026nbsp;في\u0026nbsp;أي\u0026nbsp;وقت.\u003c/li\u003e\u003c/ol\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eسادساً:\u0026nbsp;سياسة\u0026nbsp;ملفات\u0026nbsp;تعريف\u0026nbsp;الارتباط\u0026nbsp;(Cookies)\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003eنستخدم\u0026nbsp;ملفات\u0026nbsp;تعريف\u0026nbsp;الارتباط\u0026nbsp;لتحسين\u0026nbsp;تجربتك،\u0026nbsp;مثل\u0026nbsp;إبقائك\u0026nbsp;مسجلاً\u0026nbsp;للدخول،\u0026nbsp;وتذكر\u0026nbsp;لغتك\u0026nbsp;المفضلة،\u0026nbsp;وحفظ\u0026nbsp;محتويات\u0026nbsp;سلة\u0026nbsp;المشتريات.\u0026nbsp;يمكنك\u0026nbsp;تعطيل\u0026nbsp;ملفات\u0026nbsp;تعريف\u0026nbsp;الارتباط\u0026nbsp;من\u0026nbsp;خلال\u0026nbsp;إعدادات\u0026nbsp;متصفحك،\u0026nbsp;ولكن\u0026nbsp;قد\u0026nbsp;يؤثر\u0026nbsp;ذلك\u0026nbsp;على\u0026nbsp;عمل\u0026nbsp;بعض\u0026nbsp;ميزات\u0026nbsp;الموقع.\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eاتصل\u0026nbsp;بنا\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003eإذا\u0026nbsp;كان\u0026nbsp;لديك\u0026nbsp;أي\u0026nbsp;أسئلة\u0026nbsp;أو\u0026nbsp;استفسارات\u0026nbsp;حول\u0026nbsp;سياسة\u0026nbsp;الخصوصية،\u0026nbsp;يرجى\u0026nbsp;التواصل\u0026nbsp;معنا\u0026nbsp;عبر:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالبريد\u0026nbsp;الإلكتروني:\u003c/strong\u003e\u0026nbsp;support@sqlyem.com\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eصفحة\u0026nbsp;اتصل\u0026nbsp;بنا:\u003c/strong\u003e\u0026nbsp;عبر\u0026nbsp;نموذج\u0026nbsp;التواصل\u0026nbsp;في\u0026nbsp;الموقع.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e"])</script><script>self.__next_f.push([1,"19:Tf4a,"])</script><script>self.__next_f.push([1,"\u003cp