36:30.746Z\",\"updatedAt\":\"$D2026-05-08T19:36:30.746Z\",\"seoDescription_ar\":\"اشترِ تراخيص أصلية لبرامج التخزين والنسخ الاحتياطي لحماية الملفات وإدارة البيانات والتخزين السحابي مع تسليم رقمي فوري.\",\"seoDescription_en\":\"Buy genuine storage and backup software licenses for cloud storage, file protection, and secure data management with instant digital delivery.\",\"seoKeywords_ar\":null,\"seoKeywords_en\":null,\"seoTitle_ar\":\"برامج التخزين والنسخ الاحتياطي | تراخيص رقمية أصلية\",\"seoTitle_en\":\"Storage \u0026 Backup Software | Genuine Digital Licenses\",\"children\":[],\"_count\":{\"product\":3}},{\"id\":\"cat-dummy-subscriptions\",\"name\":\"Subscriptions\",\"name_en\":\"Subscriptions\",\"name_ar\":\"اشتراكات\",\"slug\":\"subscriptions-dummy\",\"description\":null,\"description_en\":null,\"description_ar\":null,\"image\":null,\"parentId\":null,\"createdAt\":\"$D2026-07-16T14:48:10.000Z\",\"updatedAt\":\"$D2026-07-16T14:48:10.000Z\",\"seoDescription_ar\":null,\"seoDescription_en\":null,\"seoKeywords_ar\":null,\"seoKeywords_en\":null,\"seoTitle_ar\":null,\"seoTitle_en\":null,\"children\":[],\"_count\":{\"product\":34}}]}],\"$L20\"]}],\"$L21\",\"$L22\",\"$L23\",\"$L24\"]}]}]}]\n"])</script><script>self.__next_f.push([1,"25:I[85370,[\"/_next/static/chunks/1608cak20tcw1.js\",\"/_next/static/chunks/133rq7uo7d2_0.js\",\"/_next/static/chunks/0311y4cy1f7h0.js\",\"/_next/static/chunks/09t2isllljna7.js\",\"/_next/static/chunks/0h1vh1yojz0fq.js\"],\"default\"]\n26:I[58058,[\"/_next/static/chunks/1608cak20tcw1.js\",\"/_next/static/chunks/133rq7uo7d2_0.js\",\"/_next/static/chunks/0311y4cy1f7h0.js\",\"/_next/static/chunks/09t2isllljna7.js\",\"/_next/static/chunks/0h1vh1yojz0fq.js\"],\"BreadcrumbLabelProvider\"]\n27:I[41582,[\"/_next/static/chunks/1608cak20tcw1.js\",\"/_next/static/chunks/133rq7uo7d2_0.js\",\"/_next/static/chunks/0311y4cy1f7h0.js\",\"/_next/static/chunks/09t2isllljna7.js\",\"/_next/static/chunks/0h1vh1yojz0fq.js\"],\"PageWrapper\"]\n28:I[44668,[\"/_next/