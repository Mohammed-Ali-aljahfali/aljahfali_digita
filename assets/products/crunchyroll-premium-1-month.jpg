der border-slate-200 dark:border-white/10 rounded-xl font-black uppercase tracking-widest text-xs hover:border-primary/40 hover:text-primary transition-all outline-none\",\"children\":[[\"$\",\"$L30\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"m21 21-4.34-4.34\",\"key\":\"14j7rj\"}],[\"circle\",{\"cx\":\"11\",\"cy\":\"11\",\"r\":\"8\",\"key\":\"4ej97u\"}]],\"className\":\"lucide-search h-4 w-4\"}],\"تصفح المنتجات\"]}]\n"])</script><script>self.__next_f.push([1,"31:I[5520,[\"/_next/static/chunks/1608cak20tcw1.js\",\"/_next/static/chunks/133rq7uo7d2_0.js\",\"/_next/static/chunks/0311y4cy1f7h0.js\",\"/_next/static/chunks/09t2isllljna7.js\",\"/_next/static/chunks/0h1vh1yojz0fq.js\",\"/_next/static/chunks/18a-_duue3yg~.js\"],\"default\"]\n32:T1ae2,"])</script><script>self.__next_f.push([1,"\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eسياسة\u0026nbsp;الخصوصية\u0026nbsp;لمنصة\u0026nbsp;SQLyem\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eتاريخ\u0026nbsp;آخر\u0026nbsp;تحديث\u003c/strong\u003e\u0026nbsp;[13\u0026nbsp;سبتمبر\u0026nbsp;2026]\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003eمرحباً\u0026nbsp;بك\u0026nbsp;في\u0026nbsp;منصة\u0026nbsp;\u003cstrong\u003eSQLyem\u003c/strong\u003e.\u0026nbsp;نحن\u0026nbsp;نقدر\u0026nbsp;خصوصيتك\u0026nbsp;ونلتزم\u0026nbsp;بحماية\u0026nbsp;بياناتك\u0026nbsp;الشخصية.\u0026nbsp;توضح\u0026nbsp;سياسة\u0026nbsp;الخصوصية\u0026nbsp;هذه\u0026nbsp;كيف\u0026nbsp;نقوم\u0026nbsp;بجمع،\u0026nbsp;استخدام،\u0026nbsp;حماية،\u0026nbsp;ومشاركة\u0026nbsp;معلوماتك\u0026nbsp;عند\u0026nbsp;استخدامك\u0026nbsp;لموقعنا\u0026nbsp;الإلكتروني\u0026nbsp;وخدماتنا.\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eأولاً:\u0026nbsp;المعلومات\u0026nbsp;التي\u0026nbsp;نجمعها\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003eنحن\u0026nbsp;نجمع\u0026nbsp;أنواعاً\u0026nbsp;معينة\u0026nbsp;من\u0026nbsp;المعلومات\u0026nbsp;لتقديم\u0026nbsp;وتحسين\u0026nbsp;خدماتنا:\u003c/p\u003e\u003col\u003e\u003cli\u003e\u003cstrong\u003eالمعلومات\u0026nbsp;الشخصية\u0026nbsp;\u003c/strong\u003eعند\u0026nbsp;التسجيل\u0026nbsp;أو\u0026nbsp;الشراء،\u0026nbsp;نجمع\u0026nbsp;اسمك،\u0026nbsp;بريدك\u0026nbsp;الإلكتروني،\u0026nbsp;ورقم\u0026nbsp;هاتفك\u0026nbsp;(إن\u0026nbsp;وجد).\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eمعلومات\u0026nbsp;الدف،\u003c/strong\u003e\u0026nbsp;نحن\u0026nbsp;لا\u0026nbsp;نخزن\u0026nbsp;تفاصيل\u0026nbsp;بطاقتك\u0026nbsp;الائتمانية\u0026nbsp;على\u0026nbsp;خوادمنا.\u0026nbsp;تتم\u0026nbsp;معالجة\u0026nbsp;جميع\u0026nbsp;المدفوعات\u0026nbsp;بشكل\u0026nbsp;آمن\u0026nbsp;عبر\u0026nbsp;بوابات\u0026nbsp;دفع\u0026nbsp;طرف\u0026nbsp;ثالث\u0026nbsp;معتمدة\u0026nbsp;(مثل\u0026nbsp;Stripe,\u0026nbsp;2Checkout,\u0026nbsp;Hoodpay).\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eبيانات\u0026nbsp;الاستخدام،\u003c/strong\u003e\u0026nbsp;نجمع\u0026nbsp;معلومات\u0026nbsp;تلقائية\u0026nbsp;حول\u0026nbsp;كيفية\u0026nbsp;تفاعلك\u0026nbsp;مع\u0026nbsp;المنصة،\u0026nbsp;مثل\u0026nbsp;عنوان\u0026nbsp;بروتوكول\u0026nbsp;الإنترنت\u0026nbsp;(IP)،\u0026nbsp;نوع\u0026nbsp;المتصفح،\u0026nbsp;الصفحات\u0026nbsp;التي\u0026nbsp;زرتها،\u0026nbsp;وتفضيلات\u0026nbsp;اللغة.\u003c/li\u003e\u003c/ol\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eثانياً:\u0026nbsp;كيف\u0026nbsp;نستخدم\u0026nbsp;معلوماتك\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003eنستخدم\u0026nbsp;البيانات\u0026nbsp;التي\u0026nbsp;نجمعها\u0026nbsp;للأغراض\u0026nbsp;التالية:\u003c/p\u003e\u003col\u003e\u003cli\u003eمعالجة\u0026nbsp;طلباتك\u0026nbsp;وتوصيل\u0026nbsp;المنتجات\u0026nbsp;الرقمية\u0026nbsp;أو\u0026nbsp;المادية.\u003c/li\u003e\u003cli\u003eإدارة\u0026nbsp;حسابك\u0026nbsp;(سواء\u0026nbsp;كنت\u0026nbsp;عميلاً،\u0026nbsp;شريكاً،\u0026nbsp;أو\u0026nbsp;مسؤولاً).\u003c/li\u003e\u003cli\u003eتحسين\u0026nbsp;واجهة\u0026nbsp;المستخدم\u0026nbsp;وتجربة\u0026nbsp;التسوق\u0026nbsp;بناءً\u0026nbsp;على\u0026nbsp;تفضيلاتك\u0026nbsp;(مثل\u0026nbsp;حفظ\u0026nbsp;تفضيلات\u0026nbsp;الوضع\u0026nbsp;الليلي\u0026nbsp;واللغة).\u003c/li\u003e\u003cli\u003eإرسال\u0026nbsp;التحديثات\u0026nbsp;المهمة،\u0026nbsp;فواتير\u0026nbsp;الشراء،\u0026nbsp;ورسائل\u0026nbsp;الدعم\u0026nbsp;الفني.\u003c/li\u003e\u003cli\u003eمنع\u0026nbsp;الاحتيال\u0026nbsp;وضمان\u0026nbsp;أمان\u0026nbsp;المنصة.\u003c/li\u003e\u003c/ol\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eثالثاً:\u0026nbsp;مشاركة\u0026nbsp;البيانات\u0026nbsp;والإفصاح\u0026nbsp;عنها\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003eنحن\u0026nbsp;لا\u0026nbsp;نبيع\u0026nbsp;بياناتك\u0026nbsp;الشخصية\u0026nbsp;لأي\u0026nbsp;طرف\u0026nbsp;ثالث.\u0026nbsp;قد\u0026nbsp;نشارك\u0026nbsp;بياناتك\u0026nbsp;فقط\u0026nbsp;في\u0026nbsp;الحالات\u0026nbsp;التالية:\u003c/p\u003e\u003col\u003e\u003cli\u003e\u003cstrong\u003eمزودي\u0026nbsp;الخدمات،\u003c/strong\u003e\u0026nbsp;نشارك\u0026nbsp;بيانات\u0026nbsp;ضرورية\u0026nbsp;مع\u0026nbsp;بوابات\u0026nbsp;الدفع\u0026nbsp;أو\u0026nbsp;شركات\u0026nbsp;الشحن\u0026nbsp;لإتمام\u0026nbsp;طلبك.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eالامتثال\u0026nbsp;القانوني،\u003c/strong\u003e\u0026nbsp;قد\u0026nbsp;نفصح\u0026nbsp;عن\u0026nbsp;معلوماتك\u0026nbsp;إذا\u0026nbsp;كان\u0026nbsp;ذلك\u0026nbsp;مطلوباً\u0026nbsp;بموجب\u0026nbsp;القانون\u0026nbsp;أو\u0026nbsp;استجابة\u0026nbsp;لطلب\u0026nbsp;قانوني\u0026nbsp;من\u0026nbsp;السلطات\u0026nbsp;المختصة.\u003c/li\u003e\u003c/ol\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eرابعاً:\u0026nbsp;أمن\u0026nbsp;البيانات\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003eنحن\u0026nbsp;نتخذ\u0026nbsp;تدابير\u0026nbsp;أمنية\u0026nbsp;تقنية\u0026nbsp;وتنظيمية\u0026nbsp;صارمة\u0026nbsp;لحماية\u0026nbsp;بياناتك\u0026nbsp;من\u0026nbsp;الوصول\u0026nbsp;غير\u0026nbsp;المصرح\u0026nbsp;به\u0026nbsp;أو\u0026nbsp;التعديل\u0026nbsp;أو\u0026nbsp;الحذف.\u0026nbsp;جميع\u0026nbsp;البيانات\u0026nbsp;المنقولة\u0026nbsp;بين\u0026nbsp;متصفحك\u0026nbsp;وخوادمنا\u0026nbsp;مشفرة\u0026nbsp;باستخدام\u0026nbsp;بروتوكولات\u0026nbsp;الأمان\u0026nbsp;القياسية\u0026nbsp;(SSL/TLS).\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eخامساً:\u0026nbsp;حقوقك\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003eبصفتك\u0026nbsp;مستخدماً\u0026nbsp;لمنصة\u0026nbsp;SQLyem،\u0026nbsp;يحق\u0026nbsp;لك:\u003c/p\u003e\u003col\u003e\u003cli\u003eالوصول\u0026nbsp;إلى\u0026nbsp;بياناتك\u0026nbsp;الشخصية\u0026nbsp;وتعديلها\u0026nbsp;عبر\u0026nbsp;صفحة\u0026nbsp;\u0026quot;حسابي\u0026quot;.\u003c/li\u003e\u003cli\u003eطلب\u0026nbsp;حذف\u0026nbsp;حسابك\u0026nbsp;وبياناتك\u0026nbsp;من\u0026nbsp;أنظمتنا.\u003c/li\u003e\u003cli\u003eسحب\u0026nbsp;موافقتك\u0026nbsp;على\u0026nbsp;استلام\u0026nbsp;الرسائل\u0026nbsp;التسويقية\u0026nbsp;في\u0026nbsp;أي\u0026nbsp;وقت.\u003c/li\u003e\u003c/ol\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eسادساً:\u0026nbsp;سياسة\u0026nbsp;ملفات\u0026nbsp;تعريف\u0026nbsp;الارتباط\u0026nbsp;(Cookies)\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003eنستخدم\u0026nbsp;ملفات\u0026nbsp;تعريف\u0026nbsp;الارتباط\u0026nbsp;لتحسين\u0026nbsp;تجربتك،\u0026nbsp;مثل\u0026nbsp;إبقائك\u0026nbsp;مسجلاً\u0026nbsp;للدخول،\u0026nbsp;وتذكر\u0026nbsp;لغتك\u0026nbsp;المفضلة،\u0026nbsp;وحفظ\u0026nbsp;محتويات\u0026nbsp;سلة\u0026nbsp;المشتريات.\u0026nbsp;يمكنك\u0026nbsp;تعطيل\u0026nbsp;ملفات\u0026nbsp;تعريف\u0026nbsp;الارتباط\u0026nbsp;من\u0026nbsp;خلال\u0026nbsp;إعدادات\u0026nbsp;متصفحك،\u0026nbsp;ولكن\u0026nbsp;قد\u0026nbsp;يؤثر\u0026nbsp;ذلك\u0026nbsp;على\u0026nbsp;عمل\u0026nbsp;بعض\u0026nbsp;ميزات\u0026nbsp;الموقع.\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003e\u003cstrong\u003eاتصل\u0026nbsp;بنا\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-direction-rtl ql-align-right\"\u003eإذا\u0026nbsp;كان\u0026nbsp;لديك\u0026nbsp;أي\u0026nbsp;أسئلة\u0026nbsp;أو\u0026nbsp;استفسارات\u0026nbsp;حول\u0026nbsp;سياسة\u0026nbsp;الخصوصية،\u0026nbsp;يرجى\u0026nbsp;التواصل\u0026nbsp;معنا\u0026nbsp;عبر:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eالبريد\u0026nbsp;الإلكتروني:\u003c/strong\u003e\u0026nbsp;support@sqlyem.com\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eصفحة\u0026nbsp;اتصل\u0026nbsp;بنا:\u003c/strong\u003e\u0026nbsp;عبر\u0026nbsp;نموذج\u0026nbsp;التواصل\u0026nbsp;في\u0026nbsp;الموقع.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003c/ul\u003e"])</script><script>self.__next_f.push([1,"33:Tf4a,"])</script><script>self.__next_f.push([1,"\u003cp\u003e\u003cstrong\u003eSQLyem\u0026nbsp;Terms\u0026nbsp;of\u0026nbsp;Service\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eLast\u0026nbsp;Updated:\u003c/strong\u003e\u0026nbsp;[September\u0026nbsp;13,\u0026nbsp;2026]\u003c/p\u003e\u003cp\u003eWelcome\u0026nbsp;to\u0026nbsp;SQLyem.\u0026nbsp;By\u0026nbsp;accessing\u0026nbsp;or\u0026nbsp;using\u0026nbsp;our\u0026nbsp;platform,\u0026nbsp;you\u0026nbsp;agree\u0026nbsp;to\u0026nbsp;be\u0026nbsp;bound\u0026nbsp;by\u0026nbsp;these\u0026nbsp;Terms\u0026nbsp;of\u0026nbsp;Service.\u0026nbsp;Please\u0026nbsp;read\u0026nbsp;them\u0026nbsp;carefully\u0026nbsp;before\u0026nbsp;using\u0026nbsp;our\u0026nbsp;website\u0026nbsp;or\u0026nbsp;services.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e1.\u0026nbsp;Account\u0026nbsp;Registration\u0026nbsp;and\u0026nbsp;Security\u003c/strong\u003e\u0026nbsp;To\u0026nbsp;access\u0026nbsp;certain\u0026nbsp;features\u0026nbsp;of\u0026nbsp;the\u0026nbsp;platform,\u0026nbsp;you\u0026nbsp;may\u0026nbsp;be\u0026nbsp;required\u0026nbsp;to\u0026nbsp;register\u0026nbsp;an\u0026nbsp;account.\u0026nbsp;You\u0026nbsp;agree\u0026nbsp;to:\u003c/p\u003e\u003cul\u003e\u003cli\u003eProvide\u0026nbsp;accurate,\u0026nbsp;current,\u0026nbsp;and\u0026nbsp;complete\u0026nbsp;information\u0026nbsp;during\u0026nbsp;registration.\u003c/li\u003e\u003cli\u003eMaintain\u0026nbsp;the\u0026nbsp;security\u0026nbsp;and\u0026nbsp;confidentiality\u0026nbsp;of\u0026nbsp;your\u0026nbsp;account\u0026nbsp;credentials.\u003c/li\u003e\u003cli\u003eBe\u0026nbsp;strictly\u0026nbsp;responsible\u0026nbsp;for\u0026nbsp;all\u0026nbsp;activities\u0026nbsp;that\u0026nbsp;occur\u0026nbsp;under\u0026nbsp;your\u0026nbsp;account.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e2.\u0026nbsp;User\u0026nbsp;Conduct\u003c/strong\u003e\u0026nbsp;By\u0026nbsp;using\u0026nbsp;SQLyem,\u0026nbsp;you\u0026nbsp;agree\u0026nbsp;not\u0026nbsp;to:\u003c/p\u003e\u003cul\u003e\u003cli\u003eUse\u0026nbsp;the\u0026nbsp;platform\u0026nbsp;for\u0026nbsp;any\u0026nbsp;illegal,\u0026nbsp;unauthorized,\u0026nbsp;or\u0026nbsp;fraudulent\u0026nbsp;purposes.\u003c/li\u003e\u003cli\u003eAttempt\u0026nbsp;to\u0026nbsp;gain\u0026nbsp;unauthorized\u0026nbsp;access\u0026nbsp;to\u0026nbsp;our\u0026nbsp;systems,\u0026nbsp;user\u0026nbsp;accounts,\u0026nbsp;or\u0026nbsp;networks.\u003c/li\u003e\u003cli\u003eInterfere\u0026nbsp;with\u0026nbsp;or\u0026nbsp;disrupt\u0026nbsp;the\u0026nbsp;performance\u0026nbsp;and\u0026nbsp;integrity\u0026nbsp;of\u0026nbsp;the\u0026nbsp;platform.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e3.\u0026nbsp;Purchases\u0026nbsp;and\u0026nbsp;Payments\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eAll\u0026nbsp;payments\u0026nbsp;made\u0026nbsp;through\u0026nbsp;SQLyem\u0026nbsp;are\u0026nbsp;processed\u0026nbsp;via\u0026nbsp;secure\u0026nbsp;third-party\u0026nbsp;gateways.\u003c/li\u003e\u003cli\u003ePrices\u0026nbsp;for\u0026nbsp;products\u0026nbsp;and\u0026nbsp;services\u0026nbsp;are\u0026nbsp;subject\u0026nbsp;to\u0026nbsp;change\u0026nbsp;without\u0026nbsp;prior\u0026nbsp;notice.\u003c/li\u003e\u003cli\u003eWe\u0026nbsp;reserve\u0026nbsp;the\u0026nbsp;right\u0026nbsp;to\u0026nbsp;refuse\u0026nbsp;or\u0026nbsp;cancel\u0026nbsp;any\u0026nbsp;order\u0026nbsp;if\u0026nbsp;fraud\u0026nbsp;or\u0026nbsp;an\u0026nbsp;unauthorized\u0026nbsp;transaction\u0026nbsp;is\u0026nbsp;suspected.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003e4.\u0026nbsp;Intellectual\u0026nbsp;Property\u003c/strong\u003e\u0026nbsp;All\u0026nbsp;content\u0026nbsp;on\u0026nbsp;the\u0026nbsp;SQLyem\u0026nbsp;platform,\u0026nbsp;including\u0026nbsp;text,\u0026nbsp;graphics,\u0026nbsp;logos,\u0026nbsp;and\u0026nbsp;software,\u0026nbsp;is\u0026nbsp;the\u0026nbsp;property\u0026nbsp;of\u0026nbsp;SQLyem\u0026nbsp;and\u0026nbsp;is\u0026nbsp;protected\u0026nbsp;by\u0026nbsp;intellectual\u0026nbsp;property\u0026nbsp;laws.\u0026nbsp;You\u0026nbsp;may\u0026nbsp;not\u0026nbsp;reproduce,\u0026nbsp;distribute,\u0026nbsp;or\u0026nbsp;modify\u0026nbsp;any\u0026nbsp;part\u0026nbsp;of\u0026nbsp;our\u0026nbsp;platform\u0026nbsp;without\u0026nbsp;prior\u0026nbsp;written\u0026nbsp;consent.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e5.\u0026nbsp;Limitation\u0026nbsp;of\u0026nbsp;Liability\u003c/strong\u003e\u0026nbsp;To\u0026nbsp;the\u0026nbsp;fullest\u0026nbsp;extent\u0026nbsp;permitted\u0026nbsp;by\u0026nbsp;law,\u0026nbsp;SQLyem\u0026nbsp;shall\u0026nbsp;not\u0026nbsp;be\u0026nbsp;liable\u0026nbsp;for\u0026nbsp;any\u0026nbsp;indirect,\u0026nbsp;incidental,\u0026nbsp;or\u0026nbsp;consequential\u0026nbsp;damages\u0026nbsp;arising\u0026nbsp;out\u0026nbsp;of\u0026nbsp;your\u0026nbsp;use\u0026nbsp;or\u0026nbsp;inability\u0026nbsp;to\u0026nbsp;use\u0026nbsp;our\u0026nbsp;platform,\u0026nbsp;products,\u0026nbsp;or\u0026nbsp;services.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e6.\u0026nbsp;Modifications\u0026nbsp;to\u0026nbsp;the\u0026nbsp;Terms\u003c/strong\u003e\u0026nbsp;We\u0026nbsp;reserve\u0026nbsp;the\u0026nbsp;right\u0026nbsp;to\u0026nbsp;update\u0026nbsp;or\u0026nbsp;modify\u0026nbsp;these\u0026nbsp;Terms\u0026nbsp;of\u0026nbsp;Service\u0026nbsp;at\u0026nbsp;any\u0026nbsp;time.\u0026nbsp;Any\u0026nbsp;changes\u0026nbsp;will\u0026nbsp;be\u0026nbsp;effective\u0026nbsp;immediately\u0026nbsp;upon\u0026nbsp;posting\u0026nbsp;on\u0026nbsp;this\u0026nbsp;page.\u0026nbsp;Your\u0026nbsp;continued\u0026nbsp;use\u0026nbsp;of\u0026nbsp;the\u0026nbsp;platform\u0026nbsp;after\u0026nbsp;changes\u0026nbsp;are\u0026nbsp;posted\u0026nbsp;constitutes\u0026nbsp;your\u0026nbsp;acceptance\u0026nbsp;of\u0026nbsp;the\u0026nbsp;revised\u0026nbsp;terms.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eContact\u0026nbsp;Us\u003c/strong\u003e\u0026nbsp;If\u0026nbsp;you\u0026nbsp;have\u0026nbsp;any\u0026nbsp;questions\u0026nbsp;about\u0026nbsp;these\u0026nbsp;Terms\u0026nbsp;of\u0026nbsp;Service,\u0026nbsp;please\u0026nbsp;contact\u0026nbsp;us\u0026nbsp;at:\u003c/p\u003e\u003cul\u003e\u003cli\u003eEmail:\u0026nbsp;support@sqlyem.com\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"7:[\"$\",\"div\",null,{\"className\":\"flex flex-col bg-slate-50 dark:bg-slate-950 font-cairo w-full overflow-x-hidden\",\"children\":[[\"$\",\"$L31\",null,{\"slides\":[{\"id\":\"cmo33dc6c0005coutbzhlmmo1\",\"title_en\":\"Welcome to SQLyem\",\"title_ar\":\"مرحبا بكم في SQLyem\",\"subtitle_en\":\"The best place for digital subscriptions.\",\"subtitle_ar\":\"مكانك المفضل للاشتراكات الرقمية.\",\"image\":\"/images/banners/Ktm2w8S5UKcIDPg3qUeFbhg7iAH7Yuv9LZRvTB1r-1776473534554.webp\",\"linkType\":\"none\",\"linkValue\":null,\"sortOrder\":0,\"isActive\":true,\"createdAt\":\"2026-04-17T15:57:25.860Z\",\"updatedAt\":\"2026-04-18T00:56:55.213Z\"},{\"id\":\"cmphb2etr0025zjcue4uj3dnu\",\"title_en\":\" \",\"title_ar\":\" \",\"subtitle_en\":\" \",\"subtitle_ar\":\" \",\"image\":\"/images/banners/WhatsApp-Image-2026-05-22-at-10-14-50-PM-1779477661903.jpeg\",\"linkType\":\"none\",\"linkValue\":null,\"sortOrder\":1,\"isActive\":true,\"createdAt\":\"2026-05-22T19:21:21.807Z\",\"updatedAt\":\"2026-05-22T19:30:55.590Z\"}],\"settings\":{\"id\":\"default\",\"siteName_en\":\"SQLyem\",\"s