nيتم تحديث المحتوى يوميًا لضمان حصولك على أحدث التصاميم والمصادر الإبداعية.\",\"seoDescription_en\":\"$227\",\"seoKeywords_ar\":null,\"seoKeywords_en\":null,\"seoTitle_ar\":\"اشتراك فري بيك | Freepik – Magnific Premiun \u0026 Premium +\",\"seoTitle_en\":\"Freepik Subscription | Freepik – Magnific Premium \u0026 Premium +\",\"stripeProductId\":null,\"stripePriceId\":null,\"partnerPrice\":null,\"offerEndsAt\":null,\"category\":{\"id\":\"cat-dummy-subscriptions\",\"name\":\"Subscriptions\",\"name_en\":\"Subscriptions\",\"name_ar\":\"اشتراكات\",\"slug\":\"subscriptions-dummy\",\"description\":null,\"description_en\":null,\"description_ar\":null,\"image\":null,\"parentId\":null,\"createdAt\":\"$D2026-07-16T14:48:10.000Z\",\"updatedAt\":\"$D2026-07-16T14:48:10.000Z\",\"seoDescription_ar\":null,\"seoDescription_en\":null,\"seoKeywords_ar\":null,\"seoKeywords_en\":null,\"seoTitle_ar\":null,\"seoTitle_en\":null},\"productvariation\":[{\"id\":\"cms5lkz610010137tayyzcgt6\",\"name\":\"Month / 20 files per day board\",\"name_en\":\"Month / 20 files per day board\",\"name_ar\":\"شهر / 20 ملف في اليوم لوحة\",\"price\":10,\"productId\":\"prod-dummy-64\",\"createdAt\":\"$D2026-07-29T04:41:37.033Z\",\"updatedAt\":\"$D2026-07-29T04:41:37.033Z\",\"stripePriceId\":null},{\"id\":\"cms5lkz610011137t4auuq2r6\",\"name\":\"Premium Month - Special offer delivered to your email: 18,000 points\",\"name_en\":\"Premium Month - Special offer delivered to your email: 18,000 points\",\"name_ar\":\"شهر Premium - خاص على ايميلك 18000 نقطة\",\"price\":18,\"productId\":\"prod-dummy-64\",\"createdAt\":\"$D2026-07-29T04:41:37.033Z\",\"updatedAt\":\"$D2026-07-29T04:41:37.033Z\",\"stripePriceId\":null},{\"id\":\"cms5lkz610012137t3c9rue46\",\"name\":\"Premium Month + / Special offer delivered to your email: 45,000 points\",\"name_en\":\"Premium Month + / Special offer delivered to your email: 45,000 points\",\"name_ar\":\"شهر Premium + / خاص على ايميلك 45000 نقط\",\"price\":38,\"productId\":\"prod-dummy-64\"